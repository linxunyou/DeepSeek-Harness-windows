{
  "name": "deepseek-harness-app",
  "version": "1.1.0",
  "description": "DeepSeek Harness Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu --disable-gpu-compositing --disable-software-rasterizer --in-process-gpu",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.deepseek.harness",
    "productName": "DeepSeek Harness",
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "DeepSeek-Harness.exe"
    },
    "files": [
      "**/*",
      "!dsh-env/**",
      "!node_modules/.cache/**",
      "!*.md"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "author": "linxunyou"
}
